<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Android 13+ 自己建 Wi-Fi Direct / 扫 P2P 设备必需 -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ 包可见性：需要检测并拉起车机互联 App -->
    <queries>
        <package android:name="com.oplus.ocar" />
        <package android:name="com.miui.carlink" />
        <package android:name="com.vivo.carassistant" />
        <package android:name="com.huawei.hicar" />
        <package android:name="com.baidu.carlife" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CastService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 真机调试入口：仅 debuggable 包响应，正式包自动忽略（见 DebugCommandReceiver） -->
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.github.carwithinforandroid.DEBUG.CARLIFE_CONNECT" />
                <action android:name="com.github.carwithinforandroid.DEBUG.CARLIFE_CONNECT_LAUNCH" />
                <action android:name="com.github.carwithinforandroid.DEBUG.TESTPATTERN" />
                <action android:name="com.github.carwithinforandroid.DEBUG.STOP" />
                <action android:name="com.github.carwithinforandroid.DEBUG.STATE" />
                <action android:name="com.github.carwithinforandroid.DEBUG.DIAGNOSE" />
                <!-- 新增命令必须在这里登记，否则 am broadcast 只会 Enqueued、不会投递 -->
                <action android:name="com.github.carwithinforandroid.DEBUG.P2P_BUILD" />
                <action android:name="com.github.carwithinforandroid.DEBUG.P2P_SCAN" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
